# Postgres connection (required). In dev the database is auto-created if missing.
# Local example: postgresql://postgres:postgres@localhost:5432/elektor
DATABASE_URL="your database url"

# DB SSL: "disable" = off (local); REJECT_UNAUTHORIZED=false = SSL but skip cert
# check (managed hosts like Render). Unset = SSL with full validation.
# DATABASE_SSL=disable
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

PORT="your port number"
NODE_ENV="development"

# Required - app won't start without it. Generate: openssl rand -hex 48
SESSION_SECRET="your session secret"

# "true" shows a one-click, read-only demo login on the admin page.
DEMO_MODE="false"
# DEMO_ADMIN_USERNAME="demo-admin"

# Seeded super admin (used by db:setup). Password must be 8+ characters.
DEFAULT_ADMIN_FIRSTNAME="default admin first name"
DEFAULT_ADMIN_LASTNAME="default admin last name"
DEFAULT_ADMIN_USERNAME="default admin username"
DEFAULT_ADMIN_PASSWORD="default admin password"
DEFAULT_ADMIN_PHONE="default admin phone number"
